#!/usr/bin/env python3
"""Offline signature check (plan §8.4, CLAUDE.md rule 7).

Resolves every entry in signatures/ee.yaml against the installed nwmain-linux
(symbols against its dynamic symbol table, patterns against its bytes) and
checks the binary hash. Exit codes: 0 ok, 1 signature problems,
2 binary hash differs from the recorded one, 3 setup error.

Usage: tools/sigcheck [--binary PATH] [--signatures PATH] [--print-hash]
"""
import argparse
import hashlib
import os
import re
import struct
import sys

try:
    import yaml
except ImportError:
    sys.exit("sigcheck needs PyYAML: pip install pyyaml")

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_BIN = os.environ.get(
    "NWN_BIN",
    os.path.expanduser("~/.local/share/Steam/steamapps/common/Neverwinter Nights/bin/linux-x86/nwmain-linux"),
)


def compile_pattern(pattern: str) -> re.Pattern:
    parts = []
    for tok in pattern.split():
        if tok in ("??", "?"):
            parts.append(b".")
        elif re.fullmatch(r"[0-9a-fA-F]{2}", tok):
            parts.append(re.escape(bytes([int(tok, 16)])))
        else:
            raise ValueError(f"bad pattern token {tok!r}")
    return re.compile(b"".join(parts), re.DOTALL)


def defined_dynsyms(data: bytes) -> dict:
    """Map defined dynamic symbol names to their addresses (ELF64 little-endian)."""
    if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
        raise ValueError("not an ELF64 little-endian file")
    shoff, = struct.unpack_from("<Q", data, 0x28)
    shentsize, shnum = struct.unpack_from("<HH", data, 0x3A)
    sections = [struct.unpack_from("<IIQQQQIIQQ", data, shoff + i * shentsize) for i in range(shnum)]
    out = {}
    for sh in sections:
        if sh[1] != 11:  # SHT_DYNSYM
            continue
        strtab = sections[sh[6]]
        str_off, sym_off, sym_size, entsize = strtab[4], sh[4], sh[5], sh[9]
        for i in range(sym_size // entsize):
            name_off, info, other, shndx, value, size = struct.unpack_from("<IBBHQQ", data, sym_off + i * entsize)
            if shndx == 0 or not name_off:  # undefined, or unnamed
                continue
            end = data.index(b"\0", str_off + name_off)
            out[data[str_off + name_off:end].decode()] = value
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--binary", default=DEFAULT_BIN)
    ap.add_argument("--signatures", default=os.path.join(ROOT, "signatures", "ee.yaml"))
    ap.add_argument("--print-hash", action="store_true")
    args = ap.parse_args()

    if not os.path.isfile(args.binary):
        print(f"setup error: binary not found: {args.binary} (set NWN_BIN)")
        return 3
    data = open(args.binary, "rb").read()
    digest = hashlib.sha256(data).hexdigest()
    if args.print_hash:
        print(digest)
        return 0

    doc = yaml.safe_load(open(args.signatures)) or {}
    expected = doc.get("binary_sha256")
    print(f"binary: {args.binary}\nsha256: {digest}")
    if expected and expected != digest:
        print(f"HASH MISMATCH: signatures were built against {expected}. Stop and report (CLAUDE.md rule 7).")
        return 2
    if not expected:
        print("note: binary_sha256 not recorded yet (M0)")

    sigs = doc.get("signatures") or {}
    problems = 0
    dynsyms = None
    for key, sig in sigs.items():
        if not sig.get("note"):
            print(f"  {key}: missing 'note' (re-notes reference)")
            problems += 1
        if ("symbol" in sig) == ("pattern" in sig):
            print(f"  {key}: INVALID (needs exactly one of 'symbol' or 'pattern')")
            problems += 1
            continue
        if "symbol" in sig:
            if dynsyms is None:
                dynsyms = defined_dynsyms(data)
            addr = dynsyms.get(sig["symbol"])
            if addr is None:
                print(f"  {key}: SYMBOL NOT FOUND {sig['symbol']}")
                problems += 1
            else:
                print(f"  {key}: ok {sig['symbol']} @ {addr:#x}")
            continue
        try:
            pat = compile_pattern(sig["pattern"])
        except ValueError as e:
            print(f"  {key}: INVALID ({e})")
            problems += 1
            continue
        hits = [m.start() + int(sig.get("offset", 0)) for m in pat.finditer(data)]
        want = int(sig.get("expect", 1))
        status = "ok" if len(hits) == want else f"EXPECTED {want}, FOUND {len(hits)}"
        if len(hits) != want:
            problems += 1
        where = ", ".join(hex(h) for h in hits[:4])
        print(f"  {key}: {status} {where}")
    print(f"{len(sigs)} signature(s), {problems} problem(s)")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
